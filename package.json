{
	"name": "newporto",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "npx tsx src/lib/server/db/seed.ts",
		"db:seed:reset": "npx tsx src/lib/server/db/seed.ts --reset"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.3",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1101.0",
		"@lucide/svelte": "^1.28.0",
		"better-auth": "^1.6.25",
		"exifr": "^7.1.3",
		"gsap": "^3.15.0",
		"lenis": "^1.3.25",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.7",
		"photoswipe": "^5.4.4",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-parse": "^9.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"sanitize-html": "^2.17.6",
		"sharp": "^0.35.3",
		"shiki": "^4.4.1",
		"unified": "^11.0.5"
	}
